# GitRepoFlow — copy to ".env" in the project root and fill in what you need.
# NEVER commit the real .env file.

# ---- AI provider (all optional; without any key the app runs deterministic-only)
# auto | lovable | openai | anthropic | google | groq | openrouter | compatible | none
AI_PROVIDER=auto
# AI_MODEL=gpt-4o-mini

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, Azure OpenAI proxy…)
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=

# ---- GitHub (optional, raises the public API rate limit)
# GITHUB_TOKEN=
